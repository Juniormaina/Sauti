# GEMINI_API_KEY: Server-side API key for Gemini AI calls (never expose in VITE_* variables or commit real keys).
# When unset (or when a capability's model variable is blank), SAUTI stays in zero-budget local fallback / Demo Mode.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# Independent Gemini Model Configuration (no hardcoded defaults in application code).
# Set only the capabilities available in your Google AI / Gemini quota tier:
GEMINI_TEXT_MODEL=""         # Required for AI pronunciation coaching, activity feedback, and summaries
GEMINI_TTS_MODEL=""          # Required for single-speaker server TTS (falls back to browser SpeechSynthesis when blank)
GEMINI_MULTI_TTS_MODEL=""    # Required for dual-speaker dialogue TTS
GEMINI_TRANSCRIBE_MODEL=""   # Required for server audio transcription
GEMINI_LIVE_MODEL="gemini-3.8-live"  # Real-time /ws/live voice conversations (defaults to gemini-3.8-live; set "disabled" to turn off)

# Set to "true" to fail server startup if GEMINI_API_KEY or any GEMINI_*_MODEL variable is missing.
AI_STRICT_MODEL_VALIDATION="false"

# APP_URL: The URL where this applet is hosted.
APP_URL="MY_APP_URL"

# SESSION_SECRET: Secret key for signing email/password auth session tokens.
SESSION_SECRET="change-this-session-secret-in-production"

# ALLOWED_ORIGINS: Optional comma-separated list of permitted browser origins for API/WS requests.
ALLOWED_ORIGINS=""

# TRUST_PROXY: Reverse-proxy trust strategy for Express & WebSocket client IP resolution.
# Examples: "false" (direct connections), "loopback,linklocal,uniquelocal" (Cloud Run / VPC ingress), or "127.0.0.1" (Nginx).
# Overly permissive values ("true", "*", "0.0.0.0/0") are rejected and fail safely to "false".
TRUST_PROXY=""

# Optional explicit non-browser WebSocket client access (disabled by default)
# WS_ALLOW_NON_BROWSER_CLIENTS="false"
# WS_NON_BROWSER_KEY=""

# Cloud SQL PostgreSQL connection environment variables (injected automatically in AI Studio)
SQL_HOST=""
SQL_DB_NAME=""
SQL_USER=""
SQL_PASSWORD=""
SQL_ADMIN_USER=""
SQL_ADMIN_PASSWORD=""
