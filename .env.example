# GEMINI_API_KEY: Required for Gemini AI API calls (TTS, transcription, Live API, coaching).
# AI Studio automatically injects this at runtime from user secrets.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# Optional Gemini Model Overrides
GEMINI_TEXT_MODEL="gemini-4-hydrogen"
GEMINI_TTS_MODEL="gemini-3.8-flash-lite-tts"
GEMINI_MULTI_TTS_MODEL="gemini-3.8-flash-tts"
GEMINI_TRANSCRIBE_MODEL="gemini-3.5-transcribe"
GEMINI_LIVE_MODEL="gemini-3.8-live"

# APP_URL: The URL where this applet is hosted.
APP_URL="MY_APP_URL"

# SESSION_SECRET: Secret key for signing email/password auth session tokens.
SESSION_SECRET="change-this-session-secret-in-production"

# ALLOWED_ORIGINS: Optional comma-separated list of permitted browser origins for API/WS requests.
ALLOWED_ORIGINS=""

# Cloud SQL PostgreSQL connection environment variables (injected automatically in AI Studio)
SQL_HOST=""
SQL_DB_NAME=""
SQL_USER=""
SQL_PASSWORD=""
SQL_ADMIN_USER=""
SQL_ADMIN_PASSWORD=""
